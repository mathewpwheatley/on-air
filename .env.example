# Copy to .env (git-ignored) and fill in. The simulator reads it on start;
# command-line options override it.

# Client ID of your Spotify developer app. Needed for live mode.
SPOTIFY_CLIENT_ID=

# Follow your real Spotify account instead of the fake player.
ON_AIR_LIVE=false

# City for real weather from Open-Meteo. Leave empty for fake weather.
ON_AIR_CITY=

# Show temperatures in Fahrenheit.
ON_AIR_FAHRENHEIT=false

# Use a 24-hour clock.
ON_AIR_CLOCK_24H=false

# IANA timezone, e.g. America/Los_Angeles. Defaults to the city's, then this computer's.
ON_AIR_TIMEZONE=

# Save each new Spotify response to this folder, for test fixtures.
ON_AIR_RECORD=

# Minutes with nothing playing before the idle screen shows (1-30).
ON_AIR_IDLE_MINUTES=5

# Simulator Window pixels per LED.
ON_AIR_SCALE=8

# Firmware only, until the setup portal saves a network: the home WiFi to
# join. Read at build time, so rebuild after changing them.
ON_AIR_WIFI_SSID=
ON_AIR_WIFI_PASSWORD=
